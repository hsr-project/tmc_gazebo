<?xml version="1.0" ?>
<sdf version="1.4">
    <model name='full_wall_55_900_2090_with_marker'>
      <link name='link'>
        <inertial>
          <mass>50</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <visual name='bottom_frame'>
          <pose>0 0 0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>0.055 0.9 0.1</size>
            </box>
          </geometry>
          <material>
            <!-- hsr_color/white -->
            <name>white</name>
            <ambient>1 1 1 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0 0 0 1</specular>
            <emissive>0 0 0 1</emissive>
            <shading>gouraud</shading>
            <receive_shadows>on</receive_shadows>
          </material>
        </visual>
        <collision name='collision_bottom_frame'>
          <pose>0 0 0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>0.055 0.9 0.1</size>
            </box>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <bounce/>
            <friction>
              <ode/>
            </friction>
            <contact>
              <ode/>
            </contact>
          </surface>
        </collision>
        <visual name='wall'>
          <pose>0 0 1.095 0 0 0</pose>
          <geometry>
            <box>
              <size>0.055 0.9 1.99</size>
            </box>
          </geometry>
          <material>
            <!-- wall/white_noise -->
            <name>white_noise</name>
            <ambient>1 1 1 1</ambient>
            <diffuse>0.5 0.5 0.5 1.0</diffuse>
            <specular>0 0 0 1.0</specular>
            <shininess>12.5</shininess>
            <pbr>
              <metal>
                <albedo_map>model://base_materials/wall/textures/wall_white_noise.png</albedo_map>
                <max_anisotropy>16</max_anisotropy>
                <metalness>0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
        <visual name='marker_0013'>
          <pose>0.035 -0.45 0.69 0 1.5708 3.1415</pose>
          <geometry>
            <box>
              <size>0.09 0.09 0.0001</size>
            </box>
          </geometry>

        <material>
          <name>Marker/0013</name>

          <ambient>1 1 1 1</ambient>  <!-- 周囲光 (真っ白) -->
          <diffuse>1 1 1 1</diffuse>  <!-- 反射光 (真っ白) -->
          <specular>0 0 0 1</specular>  <!-- 鏡面反射 (無し) -->
          <emissive>0 0 0 0</emissive>  <!-- 発光 (無し) -->

          <pbr>
            <metal>
              <albedo_map>model://marker/0013/textures/BchThin_Id0013_Size70.png</albedo_map>
              <max_anisotropy>16</max_anisotropy>
              <metalness>0.0</metalness> <!-- 金属感を排除 -->
            </metal>
          </pbr>
        </material>
        </visual>
        <collision name='collision_wall'>
          <pose>0 0 1.095 0 0 0</pose>
          <geometry>
            <box>
              <size>0.055 0.9 1.99</size>
            </box>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <bounce/>
            <friction>
              <ode/>
            </friction>
            <contact>
              <ode/>
            </contact>
          </surface>
        </collision>
        <velocity_decay>
          <linear>0</linear>
          <angular>0</angular>
        </velocity_decay>
        <self_collide>0</self_collide>
        <kinematic>0</kinematic>
        <gravity>1</gravity>
      </link>
      <static>1</static>
    </model>
</sdf>
